@import "themes/theme"

configuration {
    modi:                "drun,run,filebrowser,window";
    show-icons:          true;
    display-drun:        "  Apps";
    display-run:         "  Run";
    display-filebrowser: "  Files";
    display-window:      "  Windows";
    drun-display-format: "{name}";
    font:                "FiraCode Nerd Font 12";
}

* {
    background-color: transparent;
    text-color:       @text;
}

window {
    transparency:     "real";
    background-color: rgba(35, 38, 41, 0.95);
    border:           2px;
    border-color:     @sky;
    border-radius:    12px;
    width:            500px;
    padding:          16px;
    location:         center;
    anchor:           center;
}

mainbox {
    spacing:          12px;
    children:         [ inputbar, listview ];
}

inputbar {
    enabled:          true;
    padding:          8px 12px;
    background-color: @surface0;
    border-radius:    8px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    font:             "FiraCode Nerd Font Bold 12";
    text-color:       @sky;
}

entry {
    placeholder:       "Pesquisar...";
    placeholder-color: @subtext0;
    text-color:        @text;
    cursor:            text;
}

listview {
    enabled:          true;
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          4px;
    border:           0;
}

element {
    enabled:          true;
    padding:          8px 12px;
    border-radius:    8px;
    cursor:           pointer;
    spacing:          10px;
    children:         [ element-icon, element-text ];
}

element normal.normal {
    background-color: transparent;
    text-color:       @text;
}

element normal.active {
    background-color: transparent;
    text-color:       @sky;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @red;
}

element selected.normal {
    background-color: @sky;
    text-color:       @crust;
}

element selected.active {
    background-color: @blue;
    text-color:       @crust;
}

element selected.urgent {
    background-color: @red;
    text-color:       @crust;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}

element-icon {
    size:             24px;
    cursor:           inherit;
    background-color: transparent;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
}
