@import "theme"

configuration {
    modi: "drun,run,window";
    font: "FiraCode Nerd Font 13";
    show-icons: true;
    drun-display-format: "{name}";
    display-drun: "   Apps ";
    display-run: "   Run ";
    display-window: "   Windows ";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    background-color: transparent;
    text-color: @text;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 480px;
    background-color: @base;
    border: 2px solid @sky;
    border-radius: 14px;
    padding: 16px;
}

mainbox {
    spacing: 12px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @surface1;
    border-radius: 8px;
    padding: 8px 12px;
    spacing: 8px;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @sky;
}

entry {
    placeholder: "Pesquisar...";
    placeholder-color: @overlay1;
    text-color: @text;
    cursor: text;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 4px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    spacing: 12px;
    cursor: pointer;
    background-color: transparent;
    text-color: @text;
}

element normal.normal {
    background-color: transparent;
    text-color: @text;
}

element normal.urgent {
    background-color: transparent;
    text-color: @red;
}

element normal.active {
    background-color: transparent;
    text-color: @sky;
}

element selected.normal {
    background-color: @surface1;
    text-color: @sky;
    border: 0 0 0 3px;
    border-color: @sky;
}

element selected.urgent {
    background-color: @red;
    text-color: @crust;
}

element selected.active {
    background-color: @surface1;
    text-color: @sky;
}

element-icon {
    size: 24px;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
